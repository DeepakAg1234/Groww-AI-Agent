# Copy this file to .env and paste your key. .env is gitignored.

# Anthropic key used to cluster reviews and compose the weekly note.
# The model defaults to claude-haiku-5-5.
ANTHROPIC_API_KEY=

# Optional. Uncomment to override the defaults.
# PULSE_MODEL=claude-haiku-5-5
# PULSE_MODEL_BASE_URL=https://api.anthropic.com

# Bearer token for the hosted Docs and Gmail MCP server.
PULSE_MCP_TOKEN=

# Required on Railway. When set, Run and Publish require this bearer token.
# Leave it unset for local `python -m groww_pulse serve`: the page does not
# send the header. Set the same value on Vercel so the /api rewrite adds it.
# PULSE_API_TOKEN=

# Vercel only. Railway public host, without https://. vercel.json proxies
# /api/* to https://<this host>/api/*.
# PULSE_RAILWAY_HOST=

# Optional. config.yaml already has the Doc and the recipient.
# PULSE_DOC_ID=
# PULSE_EMAIL_TO=
# PULSE_MCP_URL=https://mcp-server-production-af95.up.railway.app/mcp
